PORT=3000

DB_SERVER=localhost
DB_PORT=1433
DB_NAME=FitMetrics
DB_USER=
DB_PASSWORD=
# En la nube (Azure SQL) pon true: la conexión va cifrada
DB_ENCRYPT=false
# Mínimo 32 caracteres. Genera uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
# Cuánto dura la sesión (30d = 30 días)
JWT_EXPIRES_IN=30d

# Dominios del frontend que pueden llamar a la API (separados por coma).
# En tu PC no hace falta: Vite usa un proxy. Al publicar, pon la dirección de tu frontend.
CORS_ORIGINS=http://localhost:5173

# Solo al publicar detrás de proxies: cuántos hay entre el usuario y la API.
# Con Vercel + Render son 2 (ver docs/despliegue.md)
TRUST_PROXY=
